# ---- EPAM DIAL (Azure-OpenAI compatible) ----
# Leave DIAL_API_KEY empty to run fully OFFLINE (deterministic hashing embeddings,
# extractive answers). Tests and CI run in this offline mode.
DIAL_API_KEY=
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2024-02-01

# DIAL *deployment* names (not raw model ids)
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small-1

# ---- Weaviate (static knowledge vector store) ----
# When unreachable, the app automatically falls back to an in-process vector store.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ---- Dynamic data (availability / prices / hours) ----
SQLITE_PATH=citypark.db

# ---- Retrieval & grounding ----
TOP_K=4
RELEVANCE_MIN_OVERLAP=0.12
RELEVANCE_MIN_SCORE=0.30
EMBEDDING_DIM=256

# ---- Stage 2: Administrator approval (human-in-the-loop) ----
ADMIN_NAME=CityPark Administrator
ADMIN_EMAIL=
# Required for the admin dashboard API; generate a private token before using it.
ADMIN_TOKEN=

# Optional SMTP email escalation (only activates when SMTP_HOST and ADMIN_EMAIL are both set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True
